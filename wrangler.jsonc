{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jarvis",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jarvis-db"
    }
  ],
  "observability": { "enabled": true }
}
